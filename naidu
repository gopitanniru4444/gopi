pipeline {
	agent any
	tools {
	    maven "maven"
	    jdk "jdk11"

	}
    stages {
        stage('Fetch Code') {
            steps {
                
                git branch: 'main', url: 'https://github.com/gopitanniru4444/gopi.git'
            }
        }

        stage('Build') {
            steps {
                
                sh 'mvn clean install'
            }
             post {
                success {
            echo 'archiving now'

            // Archive the build artifacts (e.g., .jar or .war files)
            archiveArtifacts artifacts: '**/*.war'
        }
        failure {
            echo 'Build, Test, or Checkstyle failed!'
        }
    }



        }

        stage('Test') {
            steps {
                
                sh 'mvn test'
            }
        }

        stage('Checkstyle') {
            steps {
                
                sh 'mvn checkstyle:checkstyle'
            }
        }
    }

   
}
